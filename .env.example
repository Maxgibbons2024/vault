# ──────────────────────────────────────────────────────────────────────────
# VaultBets AI — environment variables
# Everything is OPTIONAL. With nothing set, the app runs in demo mode on seed
# data. Set each group to switch that capability to live.
# ──────────────────────────────────────────────────────────────────────────

# ── Database (Supabase Postgres) ──
# Without DATABASE_URL the app uses the in-memory demo store.
# Supabase → Project Settings → Database → Connection string.
# Use the pooled (pgBouncer, port 6543) URL for DATABASE_URL and the direct
# (port 5432) URL for DIRECT_URL (used by migrations).
DATABASE_URL=
DIRECT_URL=

# ── Live data: fixtures (API-Football / api-sports.io) ──
API_FOOTBALL_KEY=
# Optional season/date overrides. The free plan only covers seasons 2021–2023,
# so pin to an in-season window to see real fixtures. Leave unset on paid plans.
FOOTBALL_SEASON=
FOOTBALL_FROM=
FOOTBALL_TO=

# ── Live data: odds (The Odds API) ──
ODDS_API_KEY=

# ── AI analysis (Anthropic / Claude) ──
# Without this, analysis is generated from a deterministic template.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Scheduled jobs auth ──
# Protects /api/ingest and /api/settle. Vercel Cron sends this automatically.
CRON_SECRET=

# ── Stripe (subscriptions) ──
# Without these, the upgrade flow activates plans instantly in demo mode.
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=

# Public base URL for Stripe success/cancel redirects
NEXT_PUBLIC_BASE_URL=http://localhost:3000
