# ──────────────────────────────────────────────────────────────────────────
# VaultBets AI — environment variables
# Everything is OPTIONAL. With nothing set, the app runs in demo mode on seed
# data. Set each group to switch that capability to live.
# ──────────────────────────────────────────────────────────────────────────

# ── Database (Supabase Postgres) ──
# Without DATABASE_URL the app uses the in-memory demo store.
# Supabase → Project Settings → Database → Connection string.
# Use the pooled (pgBouncer, port 6543) URL for DATABASE_URL and the direct
# (port 5432) URL for DIRECT_URL (used by migrations).
DATABASE_URL=
DIRECT_URL=

# ── PRIMARY live source: The Odds API (upcoming fixtures + odds + edges) ──
# Get a free key at https://the-odds-api.com/ (free tier ~500 req/month).
# Provides upcoming/live events WITH bookmaker odds; the de-vig model turns
# these into value opportunities. Maps soccer_*→football, tennis_*→tennis,
# mma*→ufc. Horse racing has no free source.
ODDS_API_KEY=
ODDS_REGIONS=uk          # comma-separated; more regions cost more quota
ODDS_MAX_SPORTS=6        # cap active sports per ingest run (quota control)

# ── Optional / legacy: API-Football (api-sports.io) ──
# Free plan only covers seasons 2022–2024, so it CANNOT serve upcoming fixtures.
# Kept for future paid stats enrichment to sharpen the model. Not required.
API_FOOTBALL_KEY=
FOOTBALL_SEASON=
FOOTBALL_FROM=
FOOTBALL_TO=

# ── AI analysis (Anthropic / Claude) ──
# Without this, analysis is generated from a deterministic template.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Telegram alerts (value opportunities) ──
# Create a bot via @BotFather → token. Add the bot as an admin of your channel.
# Channel id: public = @yourchannel; private = the -100... id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_MIN_EDGE=5      # only post picks with edge >= this %
TELEGRAM_MAX_ALERTS=15   # max posts per ingest run

# ── Scheduled jobs auth ──
# Protects /api/ingest, /api/settle and /api/telegram/notify. Vercel Cron sends this.
CRON_SECRET=

# ── Stripe (subscriptions) ──
# Without these, the upgrade flow activates plans instantly in demo mode.
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=

# Public base URL for Stripe success/cancel redirects
NEXT_PUBLIC_BASE_URL=http://localhost:3000
