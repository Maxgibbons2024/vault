// VaultBets AI database schema (Supabase Postgres).
// Mirrors src/lib/types.ts. Run `npx prisma migrate deploy` / `db push` to apply.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A tipster's white-label instance: branding + strategy + channel + subscribers.
model Tenant {
  id                String       @id @default(cuid())
  slug              String       @unique
  name              String
  status            String       @default("active") // active | paused
  brand             Json // { brand, brandSoft, accent, logoText, tagline }
  strategy          Json // { sports, markets, minEdge, minProb, maxProb, maxPicks }
  telegramBotToken  String?
  telegramChannelId String?
  customDomain      String?      @unique
  createdAt         DateTime     @default(now())
  users             User[]
  picks             TenantPick[]
}

model User {
  id           String        @id @default(cuid())
  tenantId     String? // null = platform-level (platform_admin)
  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  email        String        @unique
  name         String
  password     String // store a bcrypt/argon2 hash in production
  role         String        @default("user") // "user" | "tenant_admin" | "platform_admin"
  createdAt    DateTime      @default(now())
  subscription Subscription?

  @@index([tenantId])
}

model Subscription {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId         String?
  plan             String   @default("free") // "free" | "starter" | "pro"
  status           String   @default("active") // "active" | "trialing" | "canceled"
  currentPeriodEnd DateTime
  stripeCustomerId String?
}

// Per-tenant pick ledger: dedupe + Telegram state + settled track record.
model TenantPick {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId        String
  market         String
  bestPrice      Float
  fairOdds       Float
  edgePct        Float
  confidence     Float
  reasoning      String
  status         String    @default("pending") // pending | won | lost | void
  roi            Float     @default(0)
  createdAt      DateTime  @default(now())
  telegramSentAt DateTime?
  settledAt      DateTime?

  @@unique([tenantId, eventId, market])
  @@index([tenantId, status])
}

model Event {
  id               String        @id @default(cuid())
  externalId       String?       @unique // provider id for idempotent ingestion
  sport            String // "football" | "tennis" | "ufc" | "horse-racing"
  competition      String
  homeName         String
  awayName         String
  startsAt         DateTime
  venue            String?
  marketConfidence Int           @default(60)
  status           String        @default("scheduled") // scheduled | live | finished
  metrics          Json? // de-vig probabilities + market summary for charts
  analysis         Analysis?
  opportunities    Opportunity[]

  @@index([sport, startsAt])
}

model Analysis {
  id          String   @id @default(cuid())
  eventId     String   @unique
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  premium     Boolean  @default(true)
  published   Boolean  @default(false)
  publishedAt DateTime?
  summary     String
  sections    Json // AnalysisSection[]
  generatedBy String   @default("template") // "template" | "claude"
  updatedAt   DateTime @updatedAt
}

model Opportunity {
  id           String  @id @default(cuid())
  eventId      String
  event        Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  market       String
  bookmakerOdds Float
  fairOdds     Float
  edgePct      Float
  confidence   Float
  reasoning    String

  @@index([eventId])
}

model Result {
  id          String   @id @default(cuid())
  date        DateTime
  sport       String
  event       String
  opportunity String
  marketOdds  Float
  fairOdds    Float
  status      String // "won" | "lost" | "pending"
  roi         Float

  @@index([date])
}
